    "ios": {
        "min_version": "15.0",
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "events": [],
    "hooks": [],
    "secrets": [],
    "service_provider": "GoLeaf\\NativeEmailPicker\\EmailPickerServiceProvider"
}
