{
    "name": "goleaf/nativephp-email-picker",
    "version": "1.0.0",
    "description": "Permission-free Android account chooser bridge for Sutelio.",
    "namespace": "EmailPicker",
    "platforms": [
        "android"
    ],
    "bridge_functions": [
        {
            "name": "EmailPicker.Choose",
            "android": "com.goleaf.plugins.email_picker.EmailPickerFunctions.Choose",
            "android_params": [
                "activity"
