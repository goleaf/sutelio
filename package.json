{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sutelio",
    "private": true,
    "type": "module",
    "imports": {
        "#nativephp": "./vendor/nativephp/mobile/resources/dist/native.js"
    },
    "scripts": {
        "brand:build": "node scripts/build-brand-assets.mjs",
        "brand:native": "node scripts/apply-native-brand.mjs",
        "build": "vite build",
        "build:android": "vite build --mode=android",
        "build:ios": "vite build --mode=ios",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "jump": "concurrently --kill-others --names jump,vite \"php artisan native:jump\" \"vite\"",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:frontend": "node --experimental-strip-types --test resources/js/**/*.test.ts",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.10.0",
        "fontaine": "^0.8.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vue-tsc": "^3.3.10"
    },
    "dependencies": {
        "@inertiajs/core": "^3.6.1",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.4.0",
        "@lucide/vue": "^1.31.0",
        "@vueuse/core": "^14.4.0",
        "axios": "^1.19.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.3",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.41",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@rollup/rollup-win32-x64-msvc": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
